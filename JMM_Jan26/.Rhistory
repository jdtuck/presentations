}
library(knitr)
knitr::opts_chunk$set(cache = TRUE, warning = FALSE,
message = FALSE, cache.lazy = FALSE)
data_path = '/Users/jdtuck/Documents/Data/zbmc'
sim_time = read.table(file.path(data_path, 'PlatinumBMC_June2021', 'VinetEOS', 'TrainingData','DakotaBuild','time.out'))
sim_time = c(sim_time$V1)
simulations = read_table(
file.path(
data_path,
'PlatinumBMC_June2021',
'VinetEOS',
'TrainingData',
'lhs_12000bp_5500res.txt'
)
)
last_elem = 8
a = c(3,4,5,6,7,8)
sim_variables = simulations[, a]
sim_variables = make_matrix(sim_variables)
p = ncol(sim_variables)
new_dir = file.path(data_path, 'PlatinumBMC_June2021', 'VinetEOS', 'impala_id_bass')
ifelse(!dir.exists(file.path(new_dir)),
dir.create(file.path(new_dir)),
"Directory Exists")
save_fn = file.path(new_dir, "platinum_exp_all")
exp1 = read_table(
file.path(
data_path,
'PlatinumBMC_June2021',
'VinetEOS',
'TrainingData',
'DakotaBuild',
'suite',
'Z2765',
'Z2765S2AvgTrueTrim.dat'
),
col_names = c("time", "vel")
)
M1 = 1
N1 = 500
M = 300
time_new = seq(sim_time[M1], sim_time[N1], length.out = M)
f_sim = matrix(0, M, nrow(simulations))
for (i in 1:nrow(simulations)) {
tmp = as.numeric(simulations[i, (M1 + last_elem):(N1 + last_elem)])
f_sim[, i] = aspline(sim_time[M1:N1], tmp, time_new)$y
}
f_exp = aspline(exp1$time, exp1$vel, time_new)$y
matplot(time_new, f_sim, type = "l", col = "gray")
lines(time_new, f_exp, col = "black")
legend(
x = 0,
y = 8,
legend = c("simulation", "experiment"),
col = c("gray", "black"),
lty = 1
)
tt = seq(0, 1, length.out = M)
warp_list = multiple_align_functions(
f_sim,
tt,
f_exp,
parallel = TRUE,
showplot = FALSE,
verbose = FALSE
)
gam_sim = warp_list$warping_functions
vv_sim = gam_to_psi(warp_list$warping_functions)
ftilde_sim = warp_list$fn
vv_obs = gam_to_psi(seq(0, 1, length.out=M))
gam_obs = seq(0, 1, length.out=M)
ftilde_obs = f_exp
matplot(tt, ftilde_sim, type = "l", col = "gray")
lines(tt, ftilde_obs, col = "black")
legend(
x = 0,
y = 8,
legend = c("simulation", "experiment"),
col = c("gray", "black"),
lty = 1
)
matplot(tt, gam_sim, type = "l", col = "gray")
lines(tt, gam_obs, col = "black")
legend(
x = 0,
y = 8,
legend = c("simulation", "experiment"),
col = c("gray", "black"),
lty = 1
)
matplot(tt, vv_sim, type = "l", col = "gray")
lines(tt, vv_obs, col = "black")
legend(
x = 0,
y = 8,
legend = c("simulation", "experiment"),
col = c("gray", "black"),
lty = 1
)
emu_ftilde = mvBayes(
bass,
sim_variables,
t(ftilde_sim),
idxSamplesArg="mcmc.use",
samplesExtract = function(bass_out) list(
residSD = sqrt(bass_out$s2))
)
emu_vv = mvBayes(
bass,
sim_variables,
t(vv_sim),
basisType="pns",
idxSamplesArg="mcmc.use",
samplesExtract = function(bass_out) list(
residSD = sqrt(bass_out$s2)
)
)
plot(emu_ftilde)
r2Overall
mseOverall
varOverall
plot(emu_ftilde$basisInfo)
plot(emu_ftilde$basisInfo)
plot(emu_vv)
input_names = c('rho','B0','floort','sampt','bscale','BP0')
bounds = list()
for (i in 1:p){
bounds[[input_names[i]]] = c(min(sim_variables[,i]), max(sim_variables[,i]))
}
setup = CalibSetup(bounds, cf_bounds)
model_ftilde = ModelmvBayes(emu_ftilde, input_names)
model_vv = ModelmvBayes(emu_vv, input_names)
setup = addVecExperiments(setup, t(ftilde_obs), model_ftilde, 0.001, 20, rep(1, M))
setup = addVecExperiments(setup, t(vv_obs), model_vv, 0.01, 20, rep(1, M))
setup = setTemperatureLadder(setup, 1.05 ^ (0:19))
setup = setMCMC(setup, 4000, 2000, 1, 10)
out_cal = calibPool(setup)
uu = seq(2000, 4000, 2)
theta = tran_unif(out_cal$theta[uu, 1, ], setup$bounds_mat, names(setup$bounds))
time_new = seq(0, 1, length.out = M)
ftilde_pred_obs = evalm(setup$models[[1]], theta)
vv_pred_obs = evalm(setup$models[[2]], theta)
gam_pred_obs = v_to_gam(t(vv_pred_obs))
plot(out_cal$llik, type="l", ylab="Log-Likelihood", xlab="Iteration")
samps = data.frame(theta[c(1,2,6)])
mcmc_trace(samps)
p = mcmc_pairs(samps, off_diag_fun="hex", diag_fun = "dens")
p
mcmc_hist(samps)
matplot(
time_new,
ftilde_sim,
type = "l",
col = "gray",
lty = 1
)
matplot(
time_new,
t(ftilde_pred_obs),
type = "l",
col = "lightblue",
lty = 1,
add = TRUE
)
lines(time_new, ftilde_obs, col = "black")
legend(
"bottomright",
legend = c("simulation", "prediction", "experiment"),
col = c("gray", "lightblue", "black"),
lty = 1
)
matplot(
time_new,
vv_sim,
type = "l",
col = "gray",
lty = 1
)
matplot(
time_new,
t(vv_pred_obs),
type = "l",
col = "lightblue",
lty = 1,
add = TRUE
)
lines(time_new, vv_obs, col = "black")
legend(
"bottomright",
legend = c("simulation", "prediction", "experiment"),
col = c("gray", "lightblue", "black"),
lty = 1
)
matplot(
time_new,
gam_sim,
type = "l",
col = "gray",
lty = 1
)
matplot(
time_new,
gam_pred_obs,
type = "l",
col = "lightblue",
lty = 1,
add = TRUE
)
lines(time_new, gam_obs, col = "black")
legend(
"bottomright",
legend = c("simulation", "prediction", "experiment"),
col = c("gray", "lightblue", "black"),
lty = 1
)
obspred = matrix(0, M, length(uu))
for (i in 1:length(uu)) {
obspred[, i] = warp_f_gamma(ftilde_pred_obs[i, ], time_new, invertGamma(gam_pred_obs[, i]))
}
matplot(
time_new,
f_sim,
type = "l",
col = "gray",
lty = 1
)
matplot(
time_new,
obspred ,
type = "l",
col = "lightblue",
lty = 1,
